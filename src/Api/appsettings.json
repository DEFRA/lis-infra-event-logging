{
  "AllowedHosts": "*",
  "ArtefactStorage": {
    "BucketName": "event-logging-artefacts"
  },
  "EventSubmissionQueue": {
    "QueueUrl": "",
    "WaitTimeSeconds": 20,
    "VisibilityTimeoutSeconds": 120,
    "OutboxBatchSize": 10,
    "OutboxPollIntervalSeconds": 2,
    "SubmissionRetentionHours": 24,
    "CleanupIntervalSeconds": 3600,
    "CleanupBatchSize": 100
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Elastic.CommonSchema.Serilog.EcsTextFormatter, Elastic.CommonSchema.Serilog"
        }
      }
    ]
  }
}
